<Project Sdk="Microsoft.NET.Sdk">

  <!-- One test project for the whole Archive service. Rule tests run against Core with in-memory
       fakes; endpoint tests use WebApplicationFactory against Api. Nothing here may need the
       network, a database or a container — `dotnet test` has to pass from a clean clone offline.
       Shared build settings come from Directory.Build.props at the repository root.

       Assertions are plain xUnit on purpose: FluentAssertions v8 is commercially licensed. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nemetschek.Archive.Core\Nemetschek.Archive.Core.csproj" />
    <ProjectReference Include="..\Nemetschek.Archive.Infrastructure\Nemetschek.Archive.Infrastructure.csproj" />
    <ProjectReference Include="..\Nemetschek.Archive.Api\Nemetschek.Archive.Api.csproj" />
  </ItemGroup>

</Project>
