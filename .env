# Non-secret compose defaults only. No credential belongs in this file or in any image.
COMPOSE_PROJECT_NAME=nemetschek-archive

# Host port the Archive is published on.
ARCHIVE_PORT=8080

# Most documents one page of a query may hold. The review demo runs with this set to 5.
ARCHIVE_MAX_PAGE_SIZE=50

# Upload limits. Everything a user uploads is untrusted, so the size of a body and the number of
# parts in it are bounded before any of it is read. 268435456 is 256 MiB.
ARCHIVE_MAX_UPLOAD_BYTES=268435456
ARCHIVE_MAX_UPLOAD_ENTRIES=10000
